# Instellingen voor de TESTVERSIE van de Dash (poort 3004).
# Kopieer dit bestand naar .env.test.local en vul de lege waarden in.
# Wat hier niet staat komt uit .env.local (zoals de login en CRON_SECRET).

# Zet de Dash in testmodus: testbalk, schakelaar, geen e-mails, geen bank-sync
NEXT_PUBLIC_DASH_MODUS=test

# De lokale test-Supabase (npm run testdb:start toont de sleutel). Nooit het
# live project: de Dash weigert te starten als hier fvywfygsjslojpvqrpxw in staat.
SUPABASE_DATA_URL=http://127.0.0.1:55321
SUPABASE_DATA_SECRET_KEY=

# Zandbak voor PDF's en syncstatus, los van je echte administratie
DALEY_WERK_ROOT=/Users/daleyjansen_1/Library/Application Support/daley-dash-test/DALEY WERK
DALEY_DASH_STATE_DIR=/Users/daleyjansen_1/Library/Application Support/daley-dash-test/state

# De assistent en scripts praten met deze versie in plaats van met 3003
DASH_URL=http://127.0.0.1:3004

# Staan in .env.local op de echte administratie. Hier op de zandbak, anders leest
# de testversie je echte PDF's (de code negeert ze in test ook, dit is dubbel slot)
ADMIN_FACTUREN_PATH=/Users/daleyjansen_1/Library/Application Support/daley-dash-test/DALEY WERK/Bedrijf Administratie/Verkoopfacturen
ADMIN_OFFERTES_PATH=/Users/daleyjansen_1/Library/Application Support/daley-dash-test/DALEY WERK/Bedrijf Administratie/Offertes
